# CPU layout (IMPL.md §3). Defaults match a 4-core OCI A1 instance.
RUNNER_CPUS=0
# The loader shares CPU 0 with the runner; one core alone saturates before the
# fastest 2-core servers do.
LOADER_CPUS=0,1

# The server gets the first N of these for an N-core condition.
SERVER_CPUS=2,3
PORT=8080

# Only for starting a single server by hand (`docker compose up go`).
SERVER_CPUSET=2
CORES=1
